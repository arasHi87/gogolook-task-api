# Build output. These are anchored with a leading slash on purpose: a bare
# "taskapi" pattern matches at any depth and would silently exclude the
# cmd/taskapi/ package directory.
/bin/
/dist/
/taskapi

# Local Go workspace (shadows a parent go.work during development; a clone needs none)
go.work
go.work.sum

# Secrets and local overrides
.env
config.local.yaml

# Test / coverage artefacts
coverage.out
coverage.html
*.test

# Task's fingerprint cache
/.task/

# Proto dependencies exported for the editor's import resolution (task proto:deps).
# buf resolves these from its own module cache and does not need them.
/.proto-deps/

# OS / editor. The editor directory is ignored except for the two files that
# are project configuration rather than personal preference: where to find the
# proto imports, and which extensions make that work.
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
