# Copy to .env for the local stack. Nothing here is a real credential.
#
#   cp .env.example .env

# Published ports. Change these if any of them is already taken.
API_PORT=8080
ADMIN_PORT=9090
WORKER_ADMIN_PORT=9091
SINK_PORT=8081
PROMETHEUS_PORT=9092
GRAFANA_PORT=3000

# error | warn | info | debug | trace
LOG_LEVEL=info

# Local Postgres. Not a credential worth protecting: it is reachable only from
# the compose network, and `compose down -v` throws the data away.
POSTGRES_PASSWORD=taskapi

# Demo bearer tokens.
#
# Only their SHA-256 hashes are compiled in as defaults, which is the point:
# possessing the hash grants nothing. These plaintexts exist so the rate-limit
# demo works out of the box, and they are development credentials by
# construction — a deployment that cares replaces auth.clients entirely.
#
#   curl -H "Authorization: Bearer $DEMO_TOKEN" localhost:8080/api/v1/tasks
#
# demo   -> standard tier (100 req/s)
DEMO_TOKEN=demo-standard-token
# worker -> internal tier (1000 req/s)
INTERNAL_TOKEN=demo-internal-token
