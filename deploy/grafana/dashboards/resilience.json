      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ratelimit_active_keys)",
          "legendFormat": "buckets",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false
