    {
      "type": "timeseries",
      "title": "Load shed",
      "description": "The in-flight semaphore, which is the tier that actually keeps the process alive under overload.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_inflight_rejected_total[5m])) or vector(0))",
          "legendFormat": "shed",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
