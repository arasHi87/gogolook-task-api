          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(dead_letter_jobs_total[15m])) or vector(0))",
          "legendFormat": "discarded",
          "refId": "B",
          "instant": false,
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
