    },
    {
      "type": "row",
      "title": "Failure modes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Retry ratio",
      "description": "Alerts above 25%. Work that is not progressing, whatever the throughput graph says.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(jobs_retried_total[5m])) or vector(0)) / clamp_min(sum(rate(jobs_processed_total[5m])), 1e-9)",
          "legendFormat": "retries / outcomes",
          "refId": "A",
          "instant": false,
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
